# ==============================================================================
# LiftCare .gitignore
# Covers Java, Maven, Node.js, Vite, Environment Files, Build Outputs, IDEs, and Secrets
# ==============================================================================

# Secrets and Local Environment Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.p12

# Node.js and Frontend Build Outputs
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Java / Maven Build Outputs
backend/target/
target/
*.class
*.jar
*.war
*.ear
*.nar

# IDE & Editor Files
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.settings/
.project
.classpath
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
logs/
backend/logs/

# Database files & crash dumps
*.db
*.sqlite
*.sqlite3
hs_err_pid*
replay_pid*
