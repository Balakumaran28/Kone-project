# ==============================================================================
# LiftCare Environment Configuration Template (Module 7: Local Server & LAN)
# Offline-First Elevator Issue Management and Automatic Escalation System
# 
# Usage:
#   Copy this file to .env before starting the system:
#     cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Building Server Identity & Environment
# ------------------------------------------------------------------------------
# Active environment profile: development | production-local
LIFTCARE_ENV=production-local

# Unique physical identifier for this building's local server appliance
LIFTCARE_NODE_ID=building-local-node-01

# ------------------------------------------------------------------------------
# 2. Local Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Database name, username, and secure password for local PostgreSQL
DB_NAME=liftcare_db
DB_USERNAME=postgres
DB_PASSWORD=replace_with_strong_local_db_password
DB_PORT=5432

# JDBC URL for direct host run (e.g. ./mvnw spring-boot:run)
# When running with Docker Compose, docker-compose.yml routes to jdbc:postgresql://postgres:5432/...
DB_URL=jdbc:postgresql://localhost:5432/liftcare_db

# Hibernate DDL strategy: 'validate' (recommended for production) or 'none'
JPA_DDL_AUTO=validate

# Flyway Database Migrations: set to 'true' to automatically execute schema scripts
FLYWAY_ENABLED=true

# ------------------------------------------------------------------------------
# 3. Security & JWT Authentication
# ------------------------------------------------------------------------------
# 256-bit (minimum 32-character) secret key for signing HMAC-SHA256 tokens.
# IMPORTANT: Generate a unique, high-entropy secret before deploying to a physical server.
JWT_SECRET=replace_with_a_cryptographically_secure_random_256_bit_signing_key_at_least_32_bytes

# JWT token expiration duration in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. Networking, Ports & LAN Cross-Origin (CORS) Access
# ------------------------------------------------------------------------------
# Port for the Spring Boot backend server
SERVER_PORT=8080

# Port for the frontend web application (in Docker deployment, defaults to 80)
FRONTEND_PORT=80

# Allowed Frontend Origins for CORS (comma-separated).
# Wildcard patterns (e.g. http://192.168.*:*) permit devices across the building's Wi-Fi / Ethernet LAN.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost,http://127.0.0.1:5173,http://127.0.0.1:80,http://192.168.*:*,http://10.*:*,http://*.local:*

# ------------------------------------------------------------------------------
# 5. Frontend Client API Base URL
# ------------------------------------------------------------------------------
# In containerized production (via Nginx reverse-proxy), leave empty ("") for same-origin routing.
# In development (Vite dev server on port 5173), leave empty or set to http://<SERVER_IP>:8080.
VITE_API_BASE_URL=
